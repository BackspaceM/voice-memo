# 复制为 .env 后按需修改；docker compose 会自动读取。
# 注意：本文件不应包含任何 Docker Hub 凭据。

# Docker Hub 命名空间（镜像名前缀）。若你的 Docker Hub 用户名不是 liuyunshan613，请修改。
DOCKERHUB_USER=liuyunshan613
TAG=0.2.1

# 宿主机访问端口（容器内部固定 21087）
HOST_PORT=8787
TZ=Asia/Shanghai

# ---- 运行身份（0 = root，绿联 NAS 共享目录推荐保持 0）----
# 若要让容器内文件归属 NAS 用户，把 PUID/PGID 改成共享目录属主，
# 程序会自动 chown /data 并以该身份运行；PUID/PGID 兼容 UID/GID 变量名。
PUID=0
PGID=0
UMASK=022

# ---- 上限（0 = 不限制）----
MAX_AUDIO_MB=0
MAX_EXPORT_MB=0
MAX_EXPORT_ITEMS=0

# ---- 录音 / 下载格式（也可在 Web 设置页改）----
# wav = 通用无损（默认，自带时长，跨设备可播）；webm / mp4 / ogg / auto = 浏览器原生容器
RECORD_FORMAT=wav
DOWNLOAD_FORMAT=wav

# ---- 内置 HTTPS：启用并把 CA 装进设备信任库后，浏览器才开放麦克风 ----
# 设 1 后把 TLS_SAN 改成实际访问用的 NAS IP / 域名（多个用逗号分隔），重建容器
# 访问地址必须与 TLS_SAN 中一项一致；只点浏览器的「继续前往」无效
# 必须在「设置 → 连接与安全」下载 CA（iOS 用 .mobileconfig）安装并重启浏览器
ENABLE_HTTPS=0
TLS_SAN=localhost
# 可选：另开一个 HTTP 端口做 301 跳转（0 = 关闭），需同时映射该端口
HTTPS_REDIRECT_PORT=0

# ---- 可选：OpenAI 兼容接口；不填则转写/摘要自动降级为手动录入 ----
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1
# ASR_LANGUAGE=zh
# LLM_MODEL=gpt-4o-mini
# 如需分别配置：ASR_API_KEY / ASR_BASE_URL / LLM_API_KEY / LLM_BASE_URL
